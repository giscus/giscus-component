---
import type { GiscusProps } from './types';

type Props = GiscusProps;

const {
  id,
  host,
  repo,
  repoId,
  category,
  categoryId,
  mapping,
  term,
  strict,
  reactionsEnabled,
  emitMetadata,
  inputPosition,
  theme,
  lang,
  loading,
} = Astro.props;
---

<giscus-widget
  id={id}
  host={host}
  repo={repo}
  repoid={repoId}
  category={category}
  categoryid={categoryId}
  mapping={mapping}
  term={term}
  strict={strict}
  reactionsenabled={reactionsEnabled}
  emitmetadata={emitMetadata}
  inputposition={inputPosition}
  theme={theme}
  lang={lang}
  loading={loading}></giscus-widget>

<script>
  import 'giscus';

  // With Astro's view transitions router, the new page is swapped in before
  // the URL is updated, so a widget can render with the previous page's URL.
  // Re-create the widgets once the URL has changed.
  document.addEventListener('astro:after-swap', () => {
    for (const widget of document.querySelectorAll('giscus-widget')) {
      if (widget.closest('[data-astro-transition-persist]')) continue;
      widget.replaceWith(widget.cloneNode());
    }
  });
</script>
