---
import type { GiscusProps } from './types';

type Props = GiscusProps;

const {
  id,
  host,
  repo,
  repoId,
  category,
  categoryId,
  mapping,
  term,
  strict,
  reactionsEnabled,
  emitMetadata,
  inputPosition,
  theme,
  lang,
  loading,
} = Astro.props;
---

<giscus-widget
  id={id}
  host={host}
  repo={repo}
  repoid={repoId}
  category={category}
  categoryid={categoryId}
  mapping={mapping}
  term={term}
  strict={strict}
  reactionsenabled={reactionsEnabled}
  emitmetadata={emitMetadata}
  inputposition={inputPosition}
  theme={theme}
  lang={lang}
  loading={loading}></giscus-widget>

<script>
  import 'giscus';
</script>
